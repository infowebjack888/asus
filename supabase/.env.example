# FutureEdge AI Hub v3.0 — 環境變數範本
# 複製此檔案為 .env 並填入實際值（.env 已加入 .gitignore，絕不入版控）

# ── Supabase ──────────────────────────────────────────────
# 取得方式：Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── 加密金鑰（AES-256 for PII 欄位）─────────────────────
# 使用 openssl rand -base64 32 生成，務必妥善保存
AES_ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# ── Google Drive ──────────────────────────────────────────
GDRIVE_CLIENT_ID=your-client-id
GDRIVE_CLIENT_SECRET=your-client-secret
GDRIVE_PUBLIC_FOLDER_ID=1vks-m1wpI-r0lmkuXYSG-bf6bUON3npx

# ── Dify ──────────────────────────────────────────────────
DIFY_API_BASE=https://your-dify-instance.com
DIFY_API_KEY=your-dify-api-key

# ── Claude / Anthropic ────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
